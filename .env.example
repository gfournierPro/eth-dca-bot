# ──────────────────────────────────────────────────────────────────────────
# Exchange selection
# Choose which exchange the bot trades on: "binance", "kraken" or "okx".
# Both integrations are compiled in; flip this value to switch (e.g. back to
# binance later). Only the selected exchange's API credentials are required.
# ──────────────────────────────────────────────────────────────────────────
EXCHANGE=kraken

# Binance API Configuration (used when EXCHANGE=binance)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Kraken API Configuration (used when EXCHANGE=kraken)
# The secret is the base64 "Private Key" shown when you create the API key.
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET_KEY=your_kraken_private_key_here

# OKX API Configuration (used when EXCHANGE=okx)
# The passphrase is the one you chose when creating the API key.
# EEA (MiCA) accounts live on a separate OKX platform whose keys are rejected by
# the global endpoint with error 50119 — they must set OKX_BASE_URL=https://my.okx.com
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_api_passphrase_here
OKX_BASE_URL=https://my.okx.com

# Trading Configuration
DCA_AMOUNT_EUR=62.5
MIN_BALANCE_USDC=50.0
SCHEDULE_CRON=0 0 12 * * *

# Notion Integration (Optional)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
COLD_WALLET_ADDRESS=0x48AE396B932D062B559B11d8fC4D973E730af1eB

# Withdrawal Configuration (Optional)
WITHDRAWAL_ENABLED=false
# On Binance: WITHDRAWAL_WALLET_ADDRESS is the on-chain destination address.
# On Kraken:  it is the name of a pre-registered withdrawal key (whitelisted
#             address configured in the Kraken UI under Funding → Withdraw).
WITHDRAWAL_WALLET_ADDRESS=0x48AE396B932D062B559B11d8fC4D973E730af1eB
# WITHDRAWAL_NETWORK: used by Binance to pick the chain. On Kraken the network is
# implied by the withdrawal key, so this is informational only.
WITHDRAWAL_NETWORK=ARBITRUM
WITHDRAWAL_MIN_ETH_THRESHOLD=0.0003
# WITHDRAWAL_AMOUNT=0.5  # Optional: if not set, withdraws all available ETH

# MongoDB Configuration (if using)
MONGODB_URL=

# ──────────────────────────────────────────────────────────────────────────
# BTC DCA Workflow — runs alongside ETH in the same process by default.
# Set BTC_DCA_ENABLED=false to opt out. All BTC_* vars below are optional and
# fall back to the defaults shown. BTC uses its own Mongo collection and its
# own Notion database so its stats stay separate from ETH.
# ──────────────────────────────────────────────────────────────────────────
BTC_DCA_ENABLED=true
BTC_DCA_AMOUNT_EUR=62.5
BTC_MIN_BALANCE_USDC=50.0
BTC_SCHEDULE_CRON=0 30 5 * * MON
# BTC_TIMEZONE=Europe/Berlin   # defaults to the global TIMEZONE if unset
# BTC_MONGO_COLLECTION=btc_purchases

# BTC Notion (own database; token defaults to NOTION_TOKEN if unset)
# BTC_NOTION_TOKEN=
# BTC_NOTION_DATABASE_ID=
# BTC_COLD_WALLET_ADDRESS=bc1q...

# BTC Withdrawal (Optional)
# As above: a raw address on Binance, or a Kraken withdrawal key name on Kraken.
BTC_WITHDRAWAL_ENABLED=false
# BTC_WITHDRAWAL_WALLET_ADDRESS=my_btc_cold_wallet_key
BTC_WITHDRAWAL_NETWORK=BTC
BTC_WITHDRAWAL_MIN_THRESHOLD=0.0001
# BTC_WITHDRAWAL_AMOUNT=0.01  # Optional: if not set, withdraws all available BTC
# ──────────────────────────────────────────────────────────────────────────
# Limit-Order Sleeve (Optional) — rests post-only bids at fixed drawdown tiers
# below a rolling high, funded by a USDC chest that accrues monthly. Fully
# isolated from DCA: own budget, own Mongo collection, and tagged as "Limit
# Sleeve Fill" in the shared Notion monthly page so DCA stats stay pure.
# Set LIMIT_SLEEVE_ENABLED=true to activate; all vars below fall back to the
# defaults shown.
#
# Preview what it would place, without touching the order book:
#   cargo run --bin sleeve_smoke -- ladder --asset eth --exchange okx
# ──────────────────────────────────────────────────────────────────────────
LIMIT_SLEEVE_ENABLED=false
# LIMIT_SLEEVE_SYMBOL=ETHUSDC
# Cap on the chest at any one moment (NOT a lifetime spend cap — see accrual).
LIMIT_SLEEVE_WAR_CHEST_USDC=500.0
# 7-field cron (with seconds). Default: every 6 hours.
LIMIT_SLEEVE_REFRESH_CRON=0 0 */6 * * *
# LIMIT_SLEEVE_TIMEZONE=Europe/Berlin   # defaults to the global TIMEZONE if unset
# LIMIT_SLEEVE_MONGO_COLLECTION=limit_sleeve_fills

# --- Drawdown tiers: the strategy that actually places bids ---
# Bids rest at `rolling_high * (1 - depth)`. Levels are anchored to the high, not
# to spot, so ordinary dips can't reach the deep tiers; and each tier deploys a
# FIXED dollar amount, never a share of the remaining chest, so a shallow fill
# can't eat the money reserved for a deeper one. Routine dips are DCA's job.
#
# Lookback for the rolling high, in days.
LIMIT_SLEEVE_ANCHOR_DAYS=90
# depth:allocation_usdc pairs, shallowest first. Depths must strictly increase.
# ETH depths are set deeper than BTC's because ETH drawdowns run larger — these
# are a scaling judgement, not a backtested result (validation was BTC-only).
LIMIT_SLEEVE_TIERS=0.35:150,0.50:175,0.65:175
# Chest grows by this much per elapsed month, so one early crash can't spend a
# whole year's budget, and the sleeve revives later instead of dying at zero.
LIMIT_SLEEVE_MONTHLY_ACCRUAL_USDC=41.67
LIMIT_SLEEVE_STARTING_CHEST_USDC=250.0
LIMIT_SLEEVE_ACCRUAL_START=2026-08-01

# Volume-profile tunables. The sleeve no longer places these levels (they tracked
# spot and drained the chest on routine wiggles); kept for the `sleeve_smoke
# hvn-ladder` diagnostic. LIMIT_SLEEVE_INTERVAL_MINUTES only feeds that too.
LIMIT_SLEEVE_INTERVAL_MINUTES=60
# Price width of one bucket, in quote currency (per asset).
VP_BUCKET_SIZE_ETH=5.0
# A node counts as "high volume" at >= this fraction of the VPOC bucket's volume.
VP_HVN_THRESHOLD_RATIO=0.7
# Max number of bids in the ladder.
VP_LADDER_STEPS=4
# Require HVNs to be strict local maxima (distinct levels, not adjacent blocks).
VP_REQUIRE_LOCAL_MAXIMA=true

# ──────────────────────────────────────────────────────────────────────────
# BTC Limit-Order Sleeve (Optional) — same mechanics as the ETH sleeve above,
# on BTCUSDC, with its own war chest, its own Mongo collection, and a distinct
# Kraken userref (so the two sleeves never touch each other's orders). Fills
# mirror into the BTC Notion database (BTC_NOTION_*), tagged "Limit Sleeve Fill".
# Set BTC_LIMIT_SLEEVE_ENABLED=true to activate; all vars below fall back to
# the defaults shown.
# ──────────────────────────────────────────────────────────────────────────
BTC_LIMIT_SLEEVE_ENABLED=false
# BTC_LIMIT_SLEEVE_SYMBOL=BTCUSDC
BTC_LIMIT_SLEEVE_WAR_CHEST_USDC=1000.0
BTC_LIMIT_SLEEVE_REFRESH_CRON=0 0 */6 * * *
# BTC_LIMIT_SLEEVE_TIMEZONE=Europe/Berlin   # defaults to the global TIMEZONE if unset
BTC_LIMIT_SLEEVE_INTERVAL_MINUTES=60
# BTC_LIMIT_SLEEVE_MONGO_COLLECTION=btc_limit_sleeve_fills

# Drawdown tiers, BTC. This is the backtested configuration: replaying 2024-2026
# daily candles (Feb 2025, Nov 2025 and Feb 2026 crashes) it averaged ~80.2k,
# versus ~94k for every shallower or re-normalising variant, and still held
# ammunition for the later legs. Caveat: one asset, one window, fills modelled at
# trigger prices — it validates the structure, not the exact numbers.
BTC_LIMIT_SLEEVE_ANCHOR_DAYS=90
BTC_LIMIT_SLEEVE_TIERS=0.25:300,0.35:350,0.45:350
BTC_LIMIT_SLEEVE_MONTHLY_ACCRUAL_USDC=83.33
BTC_LIMIT_SLEEVE_STARTING_CHEST_USDC=500.0
BTC_LIMIT_SLEEVE_ACCRUAL_START=2026-08-01

# Volume-profile tunables for the BTC sleeve. Bucket width is BTC-scaled: BTC
# trades ~30-40x ETH's price, so $5 buckets would shred its profile into noise.
BTC_VP_BUCKET_SIZE=100.0
BTC_VP_HVN_THRESHOLD_RATIO=0.7
BTC_VP_LADDER_STEPS=4
BTC_VP_REQUIRE_LOCAL_MAXIMA=true
